{
  "name": "cf-lite-site-uploads",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Added with `cf-lite add d1|kv|r2`. No ids: `wrangler deploy` provisions them on first deploy; local dev works as-is.
  "d1_databases": [{ "binding": "DB", "database_name": "uploads-db" }],
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "uploads" }]
}
