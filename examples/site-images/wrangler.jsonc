{
  "name": "cf-lite-site-images",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  // ASSETS: the /_img route reads same-origin sources (/img/hero.png) through it. IMAGES: the transform binding.
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "images": { "binding": "IMAGES" }
}
