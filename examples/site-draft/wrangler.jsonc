{
  "name": "cf-lite-site-draft",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "r2_buckets": [{ "binding": "ISR_BUCKET", "bucket_name": "cf-lite-site-draft" }],
  "kv_namespaces": [{ "binding": "CONTENT" }]
}
