{
  "name": "cf-lite-demo",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    // Only these run the Worker. cf-lite appends SSR route globs automatically.
    "run_worker_first": ["/api/*"]
  },
  // Tag-purge ledger for cf-lite/modules/cache: KV (default) or D1 (set CF_CACHE_STORE=d1). Bind one, or both like this demo does.
  "kv_namespaces": [{ "binding": "CF_CACHE_TAGS" }],
  "d1_databases": [{ "binding": "CF_CACHE_DB", "database_name": "cf-lite-demo-cache" }],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "triggers": { "crons": ["*/30 * * * *"] }
}
