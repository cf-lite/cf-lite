{
  "name": "cf-lite-site-isr-route",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // `export const isr` in app/routes/posts/[id].tsx: HTML in R2, regeneration through the "isr" queue (consumer generated by cf-lite).
  "r2_buckets": [{ "binding": "ISR_BUCKET", "bucket_name": "cf-lite-site-isr-route" }],
  "kv_namespaces": [{ "binding": "CONTENT" }],
  "queues": {
    "producers": [{ "binding": "ISR_QUEUE", "queue": "isr" }],
    "consumers": [{ "queue": "isr", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 }]
  }
}
