{
  "name": "cf-lite-site-ai",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // `cf-lite add ai-chat`. Workers AI always runs on Cloudflare (even in `wrangler dev`: needs `wrangler login`, bills per use).
  // Uncomment vars.AI_GATEWAY_ID after creating a gateway to get caching/rate limits/logs.
  "ai": { "binding": "AI" }
  // "vars": { "AI_GATEWAY_ID": "my-gateway" }
}
