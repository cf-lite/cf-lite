{
  "name": "@cf-lite/preact",
  "version": "0.4.2",
  "description": "Preact adapter for cf-lite (native preact + react->preact/compat aliases, prefresh HMR)",
  "keywords": [
    "cloudflare",
    "workers",
    "vite",
    "hono",
    "ssr",
    "static-assets",
    "preact",
    "cf-lite"
  ],
  "homepage": "https://github.com/cf-lite/cf-lite#readme",
  "bugs": {
    "url": "https://github.com/cf-lite/cf-lite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cf-lite/cf-lite.git",
    "directory": "packages/preact"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "default": "./dist/islands.js"
    },
    "./islands-client": {
      "types": "./dist/islands-client.d.ts",
      "default": "./dist/islands-client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@babel/core": "^7.26.0"
  },
  "peerDependencies": {
    "cf-lite": "^0.4.0",
    "preact": "^10.20.0",
    "preact-render-to-string": "^6.5.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "preact": "^10.29.0",
    "preact-render-to-string": "^6.6.0",
    "vite": "^8.3.1"
  }
}
