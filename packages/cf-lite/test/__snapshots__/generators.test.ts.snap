exports[`generated output (snapshots = the frozen conventions) > api (+ mock + seed) and its test 1`] = `
{
  "mocks/api/blog-posts.json": "{
  "items": [
    {
      "id": "1",
      "name": "Blog posts one"
    },
    {
      "id": "2",
      "name": "Blog posts two"
    }
  ]
}
",
  "seeds/blog-posts.d1.json": "{
  "table": "blog_posts",
  "rows": [
    {
      "id": 1,
      "name": "Blog posts one"
    },
    {
      "id": 2,
      "name": "Blog posts two"
    }
  ]
}
",
  "server/api/blog-posts.ts": "import { Hono } from "hono";

type Item = { id: string; name: string };

/** /api/blog-posts: list, get one, create. Typed in the client with \`hc<ApiType>\` from \`.cf-lite/app\`. Swap the stubs for your storage (\`cf-lite add d1\`). */
export default new Hono<{ Bindings: Env }>()
  .get("/", (c) => c.json({ items: [] as Item[] }))
  .get("/:id", (c) => c.json({ error: "not found" }, 404))
  .post("/", async (c) => {
    const body = await c.req.json<{ name?: unknown }>().catch(() => ({ name: undefined }));
    if (typeof body.name !== "string" || !body.name || body.name.length > 100) return c.json({ error: "name required (max 100 chars)" }, 400);
    const item: Item = { id: crypto.randomUUID(), name: body.name };
    return c.json(item, 201);
  });
",
}
`;

exports[`generated output (snapshots = the frozen conventions) > api (+ mock + seed) and its test 2`] = `
{
  "test/api/blog-posts.test.ts": "import { describe, expect, it } from "vitest";
import { testApp } from "@cf-lite/testing";

describe("/api/blog-posts", () => {
  const app = testApp();

  it("GET lists items", async () => {
    const res = await app.fetch("/api/blog-posts");
    expect(res.status).toBe(200);
    expect(Array.isArray(((await res.json()) as { items: unknown[] }).items)).toBe(true);
  });

  it("GET unknown id is 404", async () => {
    expect((await app.fetch("/api/blog-posts/nope")).status).toBe(404);
  });

  it("POST validates the body", async () => {
    const post = (body: unknown) => app.fetch("/api/blog-posts", { method: "POST", body: JSON.stringify(body), headers: { "content-type": "application/json" } });
    expect((await post({})).status).toBe(400);
    expect((await post({ name: "x" })).status).toBe(201);
  });
});
",
}
`;

