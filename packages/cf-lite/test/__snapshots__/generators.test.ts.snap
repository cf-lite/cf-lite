exports[`generated output (snapshots = the frozen conventions) > page + component tests 2`] = `
{
  "test/components/Card.states.test.ts": "import { describe, expect, it } from "vitest";
import states from "../../app/patterns/Card/Card.states";

// Every state is plain data the preview renders: keep at least one, and keep each a props object or a function returning one.
describe("Card states", () => {
  it("defines a default state", () => {
    expect(Object.keys(states.states)).toContain("default");
  });

  it.each(Object.entries(states.states))("%s resolves to props", async (_n, s) => {
    const props = typeof s === "function" ? await s() : s;
    expect(typeof props).toBe("object");
  });
});
",
}
`;

