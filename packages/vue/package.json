{
  "name": "@cf-lite/vue",
  "version": "0.4.2",
  "description": "Vue 3 adapter for cf-lite (SFC routes, renderToWebStream SSR, hydration, HMR)",
  "keywords": [
    "cloudflare",
    "workers",
    "vite",
    "hono",
    "ssr",
    "static-assets",
    "vue",
    "cf-lite"
  ],
  "homepage": "https://github.com/cf-lite/cf-lite#readme",
  "bugs": {
    "url": "https://github.com/cf-lite/cf-lite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cf-lite/cf-lite.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "env.d.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "default": "./dist/islands.js"
    },
    "./islands-client": {
      "types": "./dist/islands-client.d.ts",
      "default": "./dist/islands-client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.9"
  },
  "peerDependencies": {
    "cf-lite": "^0.4.0",
    "vue": "^3.5.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vue": "^3.5.43",
    "vite": "^8.3.1"
  }
}
